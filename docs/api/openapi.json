          },
          "business": {
            "$ref": "#/components/schemas/BusinessDto"
          }
        }
      },
      "BusinessDto": {
        "required": [
          "id",
          "name",
          "slug",
          "siteUrl",
          "whatsApp",
          "email",
          "address",
          "instagram",
          "locale",
          "currencyCode",
          "timeZone"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "siteUrl": {
            "type": "string"
          },
