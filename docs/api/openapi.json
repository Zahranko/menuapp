        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          }
        }
      },
      "LogIn": {
        "required": [
          "login",
          "password"
        ],
        "type": "object",
        "properties": {
          "login": {
            "type": "string"
          },
          "password": {
            "type": "string"
          },
          "deviceName": {
