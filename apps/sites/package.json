{
  "name": "storefront-sites",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "templates:registry": "node scripts/build-registry.mjs",
    "templates:check": "node scripts/build-registry.mjs --check",
    "api:types": "openapi-typescript ../../docs/api/openapi.json -o lib/api-types.ts",
    "prebuild": "node scripts/build-registry.mjs --check && node scripts/copy-reserved-slugs.mjs",
    "predev": "node scripts/copy-reserved-slugs.mjs",
    "pretest": "node scripts/copy-reserved-slugs.mjs",
    "pretypecheck": "node scripts/copy-reserved-slugs.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@testing-library/dom": "^10",
    "@testing-library/react": "^16",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "jsdom": "^27",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5",
    "vite": "^8",
    "vitest": "^5"
  }
}
