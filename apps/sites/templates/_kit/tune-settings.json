{
  "motion": {
    "group": "Motion",
    "groupAr": "الحركة",
    "fields": [
      {
        "key": "motion.intro",
        "type": "choice",
        "label": "How the top of the page appears",
        "labelAr": "كيف يظهر أعلى الصفحة",
        "options": [
          "auto",
          "none",
          "fade",
          "rise",
          "zoom",
          "blur",
          "slide"
        ],
        "optionLabels": {
          "auto": "Template default",
          "none": "Still",
          "fade": "Fade in",
          "rise": "Rise up",
          "zoom": "Zoom in",
          "blur": "Come into focus",
          "slide": "Slide in"
        },
        "optionLabelsAr": {
          "auto": "كما في القالب",
          "none": "ثابت",
          "fade": "يظهر تدريجيًا",
          "rise": "يرتفع للأعلى",
          "zoom": "يقترب",
          "blur": "يتّضح تدريجيًا",
          "slide": "ينزلق من الجانب"
        }
      },
      {
        "key": "motion.hover",
        "type": "choice",
        "label": "When a visitor points at a product or button",
        "labelAr": "عند الإشارة إلى منتج أو زر",
        "options": [
          "auto",
          "none",
          "lift",
          "zoom",
          "glow",
          "tilt",
          "press"
        ],
        "optionLabels": {
          "auto": "Template default",
          "none": "Nothing moves",
          "lift": "Lifts up",
          "zoom": "Photo zooms",
          "glow": "Soft glow",
          "tilt": "Small tilt",
          "press": "Presses in"
        },
        "optionLabelsAr": {
          "auto": "كما في القالب",
          "none": "بلا حركة",
          "lift": "يرتفع قليلًا",
          "zoom": "تكبر الصورة",
          "glow": "توهج خفيف",
          "tilt": "ميل بسيط",
          "press": "ينضغط للداخل"
        }
      },
      {
        "key": "motion.speed",
        "type": "choice",
        "label": "Speed of the motion",
        "labelAr": "سرعة الحركة",
        "options": [
          "auto",
          "slow",
          "normal",
          "fast"
        ],
        "optionLabels": {
          "auto": "Template default",
          "slow": "Slow and calm",
          "normal": "Normal",
          "fast": "Quick"
        },
        "optionLabelsAr": {
          "auto": "كما في القالب",
          "slow": "بطيئة وهادئة",
          "normal": "عادية",
          "fast": "سريعة"
        }
      }
    ]
  },
  "extra": {
    "group": "Your own section",
    "groupAr": "قسمك الخاص",
    "fields": [
      {
        "key": "extra.place",
        "type": "choice",
        "label": "Where your section shows",
        "labelAr": "مكان قسمك",
        "options": [
          "off",
          "top",
          "middle",
          "bottom"
        ],
        "optionLabels": {
          "off": "Not shown",
          "top": "Under the top of the page",
          "middle": "After the menu",
          "bottom": "Above the footer"
        },
        "optionLabelsAr": {
          "off": "غير ظاهر",
          "top": "تحت أعلى الصفحة",
          "middle": "بعد القائمة",
          "bottom": "فوق أسفل الصفحة"
        }
      },
      {
        "key": "extra.layout",
        "type": "choice",
        "label": "How your section looks",
        "labelAr": "شكل قسمك",
        "options": [
          "beside",
          "card",
          "band",
          "centered"
        ],
        "optionLabels": {
          "beside": "Photo beside the text",
          "card": "A card",
          "band": "A colored band",
          "centered": "Centered text"
        },
        "optionLabelsAr": {
          "beside": "صورة بجانب النص",
          "card": "بطاقة",
          "band": "شريط ملوّن",
          "centered": "نص في المنتصف"
        }
      },
      {
        "key": "extra.eyebrow",
        "type": "text",
        "label": "Small line above the title",
        "labelAr": "سطر صغير فوق العنوان",
        "max": 40
      },
      {
        "key": "extra.title",
        "type": "text",
        "label": "Section title",
        "labelAr": "عنوان القسم",
        "max": 60
      },
      {
        "key": "extra.text",
        "type": "textarea",
        "label": "Section text",
        "labelAr": "نص القسم",
        "max": 600
      },
      {
        "key": "extra.image",
        "type": "image",
        "label": "Section photo",
        "labelAr": "صورة القسم"
      },
      {
        "key": "extra.button",
        "type": "text",
        "label": "Button text (leave empty for no button)",
        "labelAr": "نص الزر (اتركه فارغًا لإخفاء الزر)",
        "max": 28
      },
      {
        "key": "extra.link",
        "type": "text",
        "label": "Where the button goes (a web address)",
        "labelAr": "إلى أين يذهب الزر (رابط)",
        "max": 300
      }
    ]
  },
  "tune": {
    "group": "Fine tuning",
    "groupAr": "لمسات دقيقة",
    "fields": [
      {
        "key": "tune.text",
        "type": "color",
        "label": "Text color",
        "labelAr": "لون النص",
        "options": [
          "default",
          "#1E1A14",
          "#2B2B2B",
          "#14213D",
          "#1B4D3E",
          "#4A2C1D",
          "#3B1F4A",
          "#FFFFFF",
          "#F4EEE1"
        ],
        "optionLabels": {
          "default": "Template default",
          "#1E1A14": "Espresso",
          "#2B2B2B": "Graphite",
          "#14213D": "Navy",
          "#1B4D3E": "Forest",
          "#4A2C1D": "Cocoa",
          "#3B1F4A": "Plum",
          "#FFFFFF": "White",
          "#F4EEE1": "Cream"
        },
        "optionLabelsAr": {
          "default": "كما في القالب",
          "#1E1A14": "إسبريسو",
          "#2B2B2B": "رمادي داكن",
          "#14213D": "كحلي",
          "#1B4D3E": "أخضر غابات",
          "#4A2C1D": "كاكاو",
          "#3B1F4A": "برقوقي",
          "#FFFFFF": "أبيض",
          "#F4EEE1": "كريمي"
        },
        "custom": true
      },
      {
        "key": "tune.headings",
        "type": "color",
        "label": "Color of section titles",
        "labelAr": "لون عناوين الأقسام",
        "options": [
          "default",
          "accent",
          "#1E1A14",
          "#14213D",
          "#8E1B2C",
          "#1B4D3E",
          "#B08D57",
          "#5B3FD0",
          "#FFFFFF"
        ],
        "optionLabels": {
          "default": "Template default",
          "accent": "Accent color",
          "#1E1A14": "Espresso",
          "#14213D": "Navy",
          "#8E1B2C": "Wine",
          "#1B4D3E": "Forest",
          "#B08D57": "Gold",
          "#5B3FD0": "Violet",
          "#FFFFFF": "White"
        },
        "optionLabelsAr": {
          "default": "كما في القالب",
          "accent": "اللون المميز",
          "#1E1A14": "إسبريسو",
          "#14213D": "كحلي",
          "#8E1B2C": "نبيذي",
          "#1B4D3E": "أخضر غابات",
          "#B08D57": "ذهبي",
          "#5B3FD0": "بنفسجي",
          "#FFFFFF": "أبيض"
        },
        "custom": true
      },
      {
        "key": "tune.css",
        "type": "textarea",
        "label": "Your own CSS (advanced: changes how anything on your website looks)",
        "labelAr": "كود CSS خاص بك (متقدم: يغيّر شكل أي شيء في موقعك)",
        "max": 4000
      }
    ]
  },
  "defaults": {
    "motion.intro": "auto",
    "motion.hover": "auto",
    "motion.speed": "auto",
    "extra.place": "off",
    "extra.layout": "beside",
    "extra.eyebrow": "",
    "extra.title": "",
    "extra.text": "",
    "extra.image": "",
    "extra.button": "",
    "extra.link": "",
    "tune.text": "default",
    "tune.headings": "default",
    "tune.css": ""
  }
}
