    {
      "key": "ticker.edge",
      "type": "choice",
      "label": "Edges",
      "labelAr": "الحواف",
      "options": [
        "auto",
        "flames",
        "none",
        "zigzag",
        "waves"
      ],
      "optionLabels": {
        "auto": "Template default",
        "flames": "Flames",
        "none": "Straight",
        "zigzag": "Zigzag",
        "waves": "Waves"
