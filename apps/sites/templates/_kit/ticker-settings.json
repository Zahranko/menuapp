      "optionLabels": {
        "auto": "Template default",
        "diamond": "Diamonds",
        "star": "Stars",
        "dot": "Dots",
        "flame": "Flames",
        "slash": "Slashes",
        "none": "Nothing"
      },
      "optionLabelsAr": {
        "auto": "كما في القالب",
        "diamond": "معيّنات",
