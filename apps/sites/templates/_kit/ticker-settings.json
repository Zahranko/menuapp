      "optionLabelsAr": {
        "auto": "كما في القالب",
        "slow": "بطيئة",
        "normal": "عادية",
        "fast": "سريعة",
        "still": "ثابت لا يتحرك"
      },
      "previews": {
        "auto": "/kit/previews/auto.svg",
        "slow": "/kit/previews/tickerspeed-slow.svg",
        "normal": "/kit/previews/tickerspeed-normal.svg",
        "fast": "/kit/previews/tickerspeed-fast.svg",
        "still": "/kit/previews/tickerspeed-still.svg"
      }
