      "type": "choice",
      "label": "Strip color",
      "labelAr": "لون الشريط",
      "options": [
        "auto",
        "accent",
        "ink",
        "paper",
        "custom"
      ],
      "optionLabels": {
        "auto": "Template default",
        "accent": "Accent color",
        "ink": "Dark",
        "paper": "Light",
        "custom": "My own color"
      },
      "optionLabelsAr": {
        "auto": "كما في القالب",
        "accent": "اللون المميز",
        "ink": "داكن",
        "paper": "فاتح",
        "custom": "لوني الخاص"
      },
      "previews": {
        "auto": "/kit/previews/auto.svg",
        "accent": "/kit/previews/tickercolor-accent.svg",
        "ink": "/kit/previews/tickercolor-ink.svg",
        "paper": "/kit/previews/tickercolor-paper.svg",
        "custom": "/kit/previews/tickercolor-custom.svg"
      }
    },
    {
      "key": "ticker.bg",
      "type": "color",
      "label": "My own strip color",
      "labelAr": "لون الشريط الخاص",
      "options": [
        "#E5281E",
        "#FFC21A",
        "#FF5A1F",
        "#2F8F4E",
        "#1F6FEB",
        "#7B2D6E",
        "#D6336C",
        "#141110"
      ],
      "custom": true
    },
