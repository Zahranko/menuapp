{
  "group": "Moving strip",
  "groupAr": "الشريط المتحرك",
  "fields": [
    {
      "key": "ticker.style",
      "type": "choice",
      "label": "Strip shape",
      "labelAr": "شكل الشريط",
      "options": [
        "auto",
        "solid",
        "outline",
        "tilted",
        "torn",
        "tags",
        "neon",
        "double"
      ],
      "optionLabels": {
        "auto": "Template default",
        "solid": "Solid band",
        "outline": "Outline",
        "tilted": "Tilted",
        "torn": "Torn paper",
        "tags": "Label tags",
        "neon": "Neon line",
        "double": "Double lines"
      },
      "optionLabelsAr": {
        "auto": "كما في القالب",
        "solid": "شريط ممتلئ",
        "outline": "إطار فقط",
        "tilted": "مائل",
        "torn": "ورق ممزّق",
        "tags": "ملصقات منفصلة",
        "neon": "خط نيون",
        "double": "خطوط مزدوجة"
      },
      "previews": {
        "auto": "/kit/previews/auto.svg",
        "solid": "/kit/previews/ticker-solid.svg",
        "outline": "/kit/previews/ticker-outline.svg",
        "tilted": "/kit/previews/ticker-tilted.svg",
        "torn": "/kit/previews/ticker-torn.svg",
