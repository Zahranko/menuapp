{
  "fontsAndColors": {
    "group": "Fonts & colors",
    "moves": ["font", "theme", "accent"],
    "fields": [
      {
        "key": "font.family",
        "type": "choice",
        "label": "Font",
        "options": ["default", "cairo", "tajawal", "almarai", "plex", "kufi", "readex", "messiri", "amiri", "lalezar", "rubik"],
        "optionLabels": {
          "default": "Template default",
          "cairo": "Cairo",
          "tajawal": "Tajawal",
          "almarai": "Almarai",
          "plex": "IBM Plex",
          "kufi": "Noto Kufi",
          "readex": "Readex Pro",
          "messiri": "El Messiri",
          "amiri": "Amiri (classic)",
          "lalezar": "Lalezar (poster)",
          "rubik": "Rubik (rounded)"
        }
      }
    ],
    "afterTheme": [
      {
        "key": "colors.background",
        "type": "color",
        "label": "Background color",
        "options": ["default", "#FFFFFF", "#FBF7EE", "#F1E6D2", "#E9E7E2", "#FFF4D6", "#FBE9E7", "#EEE8F7", "#E4EFF8", "#E3F2EA", "#E6ECDF", "#1E2B22", "#14213D", "#26292E", "#0E0E0E"],
        "optionLabels": {
          "default": "Template default",
          "#FFFFFF": "White",
          "#FBF7EE": "Cream",
          "#F1E6D2": "Sand",
          "#E9E7E2": "Stone",
          "#FFF4D6": "Butter",
          "#FBE9E7": "Blush",
          "#EEE8F7": "Lavender",
          "#E4EFF8": "Sky",
          "#E3F2EA": "Mint",
          "#E6ECDF": "Sage",
          "#1E2B22": "Forest",
          "#14213D": "Navy",
          "#26292E": "Charcoal",
          "#0E0E0E": "Black"
        },
        "custom": true
      }
    ],
    "accentExtras": ["#8E1B2C", "#C8102E", "#F0644A", "#E8590C", "#D99A00", "#F2C14E", "#7A9A2E", "#2F8F4E", "#1B4D3E", "#7CC4A4", "#0E7C86", "#5BB5D6", "#1F6FEB", "#1E3A8A", "#9C8CE0", "#5B3FD0", "#7B2D6E", "#D6336C", "#F2A0B8", "#A3B18A", "#B08D57", "#7A4E2D", "#6B7280", "#2B2B2B"]
  },
  "fields": [
    {
      "key": "footer.nameSize",
      "type": "choice",
      "label": "Business name size in the footer",
      "group": "Footer",
      "options": ["large", "medium", "small"],
      "optionLabels": {
        "large": "Large (as designed)",
        "medium": "Medium",
        "small": "Small"
      }
    },
    {
      "key": "social.show",
      "type": "toggles",
      "label": "Accounts to show on your website",
      "group": "Social media",
      "options": ["instagram", "whatsapp", "facebook", "tiktok", "snapchat", "phone"],
      "optionLabels": {
        "instagram": "Instagram",
        "whatsapp": "WhatsApp",
        "facebook": "Facebook",
        "tiktok": "TikTok",
        "snapchat": "Snapchat",
        "phone": "Phone (call us)"
      }
    },
    {
      "key": "order.action",
      "type": "choice",
      "label": "What the button does",
      "group": "Order button",
      "options": ["auto", "whatsapp", "call", "instagram", "facebook", "hide"],
      "optionLabels": {
        "auto": "Template default",
        "whatsapp": "Order on WhatsApp",
        "call": "Call us",
        "instagram": "Open Instagram",
        "facebook": "Open Facebook",
        "hide": "Hide the button"
      }
    },
    {
      "key": "order.shape",
      "type": "choice",
      "label": "Button shape",
      "group": "Order button",
      "options": ["auto", "pill", "rounded", "circle"],
      "optionLabels": {
        "auto": "Template default",
        "pill": "Pill",
        "rounded": "Rounded square",
        "circle": "Round icon only"
      }
    },
    {
      "key": "order.position",
      "type": "choice",
      "label": "Button position",
      "group": "Order button",
      "options": ["auto", "end", "start", "center"],
      "optionLabels": {
        "auto": "Template default",
        "end": "Bottom corner",
        "start": "Other bottom corner",
        "center": "Bottom middle"
      }
    },
    {
      "key": "order.label",
      "type": "text",
      "label": "Button text (leave empty for the usual text)",
      "group": "Order button",
      "max": 28
    }
  ],
  "defaults": {
    "font.family": "default",
    "colors.background": "default",
    "footer.nameSize": "large",
    "social.show": [],
    "order.action": "auto",
    "order.shape": "auto",
    "order.position": "auto",
    "order.label": ""
  }
}
