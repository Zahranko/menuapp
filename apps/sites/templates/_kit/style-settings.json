{
  "group": "Page style",
  "groupAr": "شكل الصفحة",
  "fields": [
    {
      "key": "style.textSize",
      "type": "choice",
      "label": "Text size",
      "labelAr": "حجم النص",
      "options": [
        "auto",
        "smaller",
        "larger",
        "big"
      ],
      "optionLabels": {
        "auto": "Template default",
        "smaller": "Smaller",
        "larger": "Larger",
        "big": "Big"
      },
      "optionLabelsAr": {
        "auto": "كما في القالب",
        "smaller": "أصغر",
        "larger": "أكبر",
        "big": "كبير جدًا"
      },
      "previews": {
        "auto": "/kit/previews/auto.svg",
        "smaller": "/kit/previews/textsize-smaller.svg",
        "larger": "/kit/previews/textsize-larger.svg",
        "big": "/kit/previews/textsize-big.svg"
      }
    },
    {
