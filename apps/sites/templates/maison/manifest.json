{
  "id": "maison",
  "number": 22,
  "name": "Maison",
  "category": "Fine dining",
  "description": "A dark, gold-lined restaurant site with a menu bar, category pages, best sellers and a gallery.",
  "ar": {
    "name": "ميزون",
    "category": "مطعم راقٍ",
    "description": "موقع مطعم داكن بلمسات ذهبية، مع شريط قائمة وصفحات للأقسام والأكثر مبيعًا ومعرض صور."
