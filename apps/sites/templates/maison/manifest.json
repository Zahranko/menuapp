  "schema": [
    {
      "key": "font",
      "type": "choice",
      "label": "Font style",
      "group": "Brand",
      "options": [
        "elegant",
        "classic",
        "naskh"
      ],
      "optionLabels": {
        "elegant": "Elegant",
        "classic": "Classic",
        "naskh": "Naskh"
      }
    },
    {
      "key": "logo",
      "type": "image",
      "label": "Logo",
      "group": "Brand"
    },
    {
      "key": "theme",
      "type": "palette",
      "label": "Color theme",
      "group": "Brand",
      "options": [
        "noir",
        "bordeaux",
        "ivory",
        "olive"
      ],
      "swatches": {
        "noir": "#0E0D0B",
        "bordeaux": "#1C0E12",
        "ivory": "#F7F2E8",
        "olive": "#151A13"
      }
    },
    {
      "key": "accent",
      "type": "color",
      "label": "Gold color",
      "group": "Brand",
      "options": [
        "#C9A45C",
        "#D8B98A",
        "#B5523B",
        "#8FA57A"
      ]
    },
    {
      "key": "corners",
      "type": "choice",
      "label": "Corners",
      "group": "Brand",
      "options": [
        "rounded",
        "sharp"
      ],
      "optionLabels": {
        "rounded": "Rounded",
        "sharp": "Sharp"
      }
    },
    {
