      "type": "choice",
      "label": "Menu bar",
      "group": "Navigation",
      "options": [
        "classic",
        "centered",
        "floating"
      ],
      "optionLabels": {
        "classic": "Classic",
        "centered": "Centered name",
        "floating": "Floating bar"
      }
    },
    {
      "key": "cta.label",
      "type": "text",
      "label": "Order button text",
      "group": "Navigation",
      "max": 30
