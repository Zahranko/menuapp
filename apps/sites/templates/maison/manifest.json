    {
      "key": "hero.layout",
      "type": "choice",
      "label": "Layout",
      "group": "Hero header",
      "options": [
        "cover",
        "split",
        "slides",
        "text"
      ],
      "optionLabels": {
        "cover": "Full image",
        "split": "Split",
        "slides": "Slideshow",
        "text": "Text only"
      }
    },
    {
      "key": "hero.images",
      "type": "images",
      "label": "Hero photos (slideshow uses all)",
      "group": "Hero header",
      "max": 4,
      "presets": [
        "noir",
        "loft",
        "shelf",
        "embers",
        "blossom",
        "marble",
        "counter",
        "arches",
        "pour",
        "beans",
        "flames",
        "leaves",
        "sprinkles",
        "tiles",
        "dunes"
      ]
    },
    {
      "key": "hero.shade",
      "type": "range",
      "label": "Image darkness",
      "group": "Hero header",
      "min": 0,
      "max": 90,
      "step": 5
    },
    {
      "key": "hero.eyebrow",
      "type": "text",
      "label": "Small line above the headline",
      "group": "Hero header",
      "max": 40
    },
    {
      "key": "hero.title",
      "type": "text",
      "label": "Headline",
      "group": "Hero header",
      "max": 70
