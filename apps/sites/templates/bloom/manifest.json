{
  "id": "bloom",
  "number": 26,
  "name": "Bloom",
  "category": "Bakery and sweets",
  "description": "A soft, pastel site for bakeries and dessert shops: round category bubbles, best sellers and a sweet gallery.",
  "version": 1,
  "tier": "pro",
  "thumbnail": "/templates/bloom/thumbnail.png",
  "sample": "bloom",
  "schema": [
    {
      "key": "font",
      "type": "choice",
      "label": "Font style",
      "group": "Brand",
      "options": [
        "round",
        "soft",
        "hand"
      ],
      "optionLabels": {
        "round": "Friendly",
        "soft": "Soft serif",
        "hand": "Handwritten"
      }
    },
    {
      "key": "logo",
      "type": "image",
      "label": "Logo",
      "group": "Brand"
    },
    {
      "key": "theme",
      "type": "palette",
      "label": "Color theme",
      "group": "Brand",
      "options": [
        "blush",
        "butter",
        "lilac",
        "cocoa"
      ],
      "swatches": {
        "blush": "#FFF5F6",
        "butter": "#FFF8E7",
        "lilac": "#F6F2FD",
        "cocoa": "#2B1D1A"
      }
    },
    {
      "key": "accent",
      "type": "color",
      "label": "Accent color",
      "group": "Brand",
      "options": [
        "#E05A84",
        "#F08A4B",
        "#7C5CD6",
        "#3FA88B"
      ]
    },
    {
      "key": "corners",
      "type": "choice",
      "label": "Corners",
      "group": "Brand",
      "options": [
        "rounded",
        "sharp"
      ],
      "optionLabels": {
        "rounded": "Rounded",
        "sharp": "Sharp"
      }
    },
    {
      "key": "nav.style",
      "type": "choice",
      "label": "Menu bar",
      "group": "Navigation",
      "options": [
        "classic",
        "centered",
        "floating"
      ],
      "optionLabels": {
        "classic": "Classic",
        "centered": "Centered name",
        "floating": "Floating bar"
      }
    },
    {
      "key": "cta.label",
      "type": "text",
      "label": "Order button text",
      "group": "Navigation",
      "max": 30
    },
    {
      "key": "hero.layout",
      "type": "choice",
      "label": "Layout",
      "group": "Hero header",
      "options": [
        "cover",
        "split",
        "slides",
        "text"
      ],
      "optionLabels": {
        "cover": "Full image",
        "split": "Split",
        "slides": "Slideshow",
        "text": "Text only"
      }
    },
    {
      "key": "hero.images",
      "type": "images",
      "label": "Hero photos (slideshow uses all)",
      "group": "Hero header",
      "max": 4,
      "presets": [
        "noir",
        "loft",
        "shelf",
        "embers",
        "blossom",
        "marble",
        "counter",
        "arches",
        "pour",
        "beans",
        "flames",
        "leaves",
        "sprinkles",
        "tiles",
        "dunes"
      ]
    },
    {
      "key": "hero.shade",
      "type": "range",
      "label": "Image darkness",
      "group": "Hero header",
      "min": 0,
      "max": 90,
      "step": 5
    },
    {
      "key": "hero.eyebrow",
      "type": "text",
      "label": "Small line above the headline",
      "group": "Hero header",
      "max": 40
    },
    {
      "key": "hero.title",
      "type": "text",
      "label": "Headline",
      "group": "Hero header",
      "max": 70
    },
    {
      "key": "hero.subtitle",
      "type": "textarea",
      "label": "Subtext",
      "group": "Hero header",
      "max": 180
    },
    {
      "key": "cards",
      "type": "choice",
      "label": "Product cards",
      "group": "Layout",
      "options": [
        "classic",
        "overlay",
        "minimal"
      ],
      "optionLabels": {
        "classic": "Photo and text",
        "overlay": "Text on photo",
        "minimal": "Compact list"
      }
    },
    {
      "key": "categories.style",
      "type": "choice",
      "label": "Category tiles",
      "group": "Layout",
      "options": [
        "tiles",
        "circles",
        "banners"
      ],
      "optionLabels": {
        "tiles": "Tiles",
        "circles": "Circles",
        "banners": "Wide banners"
      }
    },
    {
      "key": "density",
      "type": "choice",
      "label": "Grid",
      "group": "Layout",
      "options": [
        "comfy",
        "dense"
      ],
      "optionLabels": {
        "comfy": "Roomy",
        "dense": "More per row"
      }
    },
    {
      "key": "motion",
      "type": "toggle",
      "label": "Animations",
      "group": "Layout"
    },
    {
      "key": "sections",
      "type": "toggles",
      "label": "Home page sections",
      "group": "Sections",
      "options": [
        "announcement",
        "best",
        "story",
        "gallery",
        "reviews",
        "visit"
      ],
      "optionLabels": {
        "announcement": "Announcement bar",
        "best": "Best sellers",
        "story": "About us",
        "gallery": "Gallery",
        "reviews": "Reviews",
        "visit": "Hours and contact"
      }
    },
    {
      "key": "announcement",
      "type": "text",
      "label": "Announcement",
      "group": "Sections",
      "max": 80
    },
    {
      "key": "categories.title",
