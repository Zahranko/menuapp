      "max": 220
    },
    {
      "key": "reviews.2.name",
      "type": "text",
      "label": "Review 2 by",
      "group": "Reviews",
      "max": 40
    },
    {
      "key": "reviews.3.quote",
      "type": "textarea",
      "label": "Review 3",
      "group": "Reviews",
      "max": 220
    },
    {
      "key": "reviews.3.name",
      "type": "text",
      "label": "Review 3 by",
      "group": "Reviews",
      "max": 40
    },
    {
      "key": "footer.text",
