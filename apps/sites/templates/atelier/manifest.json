{
  "id": "atelier",
  "number": 17,
  "name": "Atelier",
  "category": "Salon, beauty",
  "description": "An editorial website for a salon or beauty studio, with a price list people can book from.",
  "version": 1,
  "thumbnail": "/templates/atelier/thumbnail.png",
  "sample": "salon",
  "schema": [
    {
      "key": "font",
      "type": "choice",
      "label": "Font style",
      "group": "Brand",
      "options": ["elegant", "classic", "modern"],
      "optionLabels": {
        "elegant": "Elegant",
        "classic": "Classic",
        "modern": "Modern"
      }
    },
    {
      "key": "logo",
      "type": "image",
      "label": "Logo",
      "group": "Brand"
    },
    {
      "key": "theme",
      "type": "palette",
      "label": "Color theme",
      "group": "Brand",
      "options": ["blush", "sand", "sage", "noir"],
      "swatches": {
        "blush": "#FAF5F2",
        "sand": "#F5F0E8",
        "sage": "#F1F3EE",
        "noir": "#141212"
      }
    },
    {
      "key": "accent",
      "type": "color",
      "label": "Accent color",
      "group": "Brand",
      "options": ["#B76E79", "#8C6A4A", "#4F6F5B", "#111111"]
    },
    {
      "key": "hero.eyebrow",
      "type": "text",
      "label": "Small line above the headline",
      "group": "Top",
      "max": 40
    },
    {
      "key": "hero.title",
      "type": "text",
      "label": "Headline",
      "group": "Top",
      "max": 60
    },
    {
      "key": "hero.subtitle",
      "type": "textarea",
      "label": "Text under the headline",
      "group": "Top",
      "max": 160
    },
    {
      "key": "hero.image",
      "type": "image",
      "label": "Main picture",
      "group": "Top",
      "presets": ["marble", "arches", "leaves", "rings"]
    },
    {
      "key": "book.message",
      "type": "text",
      "label": "WhatsApp booking message",
      "group": "Booking",
      "max": 80
    },
    {
      "key": "sections",
      "type": "toggles",
      "label": "Sections",
      "group": "Sections",
      "options": [
        "announcement",
        "highlights",
        "story",
        "gallery",
        "reviews",
        "visit"
      ],
      "optionLabels": {
        "announcement": "Announcement bar",
        "highlights": "Highlights",
        "story": "About",
        "gallery": "Photos",
        "reviews": "Reviews",
        "visit": "Hours and contact"
      }
    },
    {
      "key": "announcement",
      "type": "text",
      "label": "Announcement",
      "group": "Sections",
      "max": 80
    },
    {
      "key": "highlights.1.title",
