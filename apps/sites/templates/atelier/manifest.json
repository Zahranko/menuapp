      "group": "Reviews",
      "max": 40
    },
    {
      "key": "reviews.3.quote",
      "type": "textarea",
      "label": "Review 3",
      "group": "Reviews",
      "max": 240
    },
    {
      "key": "reviews.3.name",
      "type": "text",
      "label": "Reviewer 3",
      "group": "Reviews",
      "max": 40
    },
    {
      "key": "hours",
      "type": "hours",
      "label": "Opening hours",
      "group": "Visit and contact"
    }
  ],
