      "type": "text",
      "label": "Highlight 3",
      "group": "Highlights",
      "max": 40
    },
    {
      "key": "highlights.3.text",
      "type": "textarea",
      "label": "Highlight text 3",
      "group": "Highlights",
      "max": 90
    },
    {
      "key": "services.title",
      "type": "text",
      "label": "Services headline",
      "group": "Services",
      "max": 60
    },
    {
      "key": "story.title",
      "type": "text",
      "label": "About headline",
      "group": "About",
      "max": 60
    },
    {
      "key": "story.text",
      "type": "textarea",
      "label": "About",
      "group": "About",
